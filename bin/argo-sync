#!/usr/bin/env python3
"""argo-sync — rename + upstream-sync engine entry point.

This script is the low-level entry point for the argo-agent sync workflow.
Operators should normally invoke it via ``argo update``, which wraps this
script with additional precondition checks, progress reporting, and state
tracking.

Workflow
--------
A full sync run performs four ordered steps:

1. **Fetch** — ``git fetch upstream`` pulls the latest upstream commits
   into the ``upstream`` remote without touching any local branch.
2. **Merge** — ``git merge upstream/main`` fast-forwards
   ``upstream-mirror`` to the latest upstream tip, then merges
   ``upstream-mirror`` into ``main`` (the argo-renamed branch).
3. **Rename** — :class:`argo_sync.engine.RenameEngine` applies all
   mappings from ``argo-rename.yaml`` in a deterministic, idempotent
   three-pass order (content → filenames → directories), writing a
   manifest to ``.argo/sync-manifest.json``.
4. **Commit** — the renamed tree is staged and committed with a message
   referencing the upstream SHA, e.g.
   ``sync: apply argo rename from upstream@<short-sha>``.

Conflict Resolution
-------------------
If step 2 produces a merge conflict:

- ``argo update`` (or this script) exits non-zero and prints the
  conflicting paths.
- Resolve conflicts manually with your preferred editor/merge tool.
- Run ``git add <resolved-files>`` to stage the resolved files.
- Run ``argo update --resume`` (or ``argo-sync --resume``) to complete
  the rename pass and commit.

Do **not** run ``git merge --continue`` — the rename engine must run
after the conflict is resolved but before the commit.

Synopsis
--------
    argo-sync                 # full sync: fetch upstream + merge + rename + commit
    argo-sync --rename-only   # rename pass only, no git fetch/merge
    argo-sync --merge-only    # merge upstream into main, skip rename engine
    argo-sync --resume        # resume after manual conflict resolution
"""

from __future__ import annotations

import argparse
import sys


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="argo-sync",
        description="Sync argo-agent with the upstream remote and re-apply the rename.",
    )
    p.add_argument("--rename-only", action="store_true", help="run only the rename pass (no git operations)")
    p.add_argument("--merge-only", action="store_true", help="run only the upstream merge (no rename)")
    p.add_argument("--resume", action="store_true", help="resume after manual conflict resolution")
    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    parser.parse_args(argv)
    print("argo-sync: scaffolding (M1). Real implementation lands in M2 + M4.", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
